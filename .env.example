# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Resend API Configuration for Server Booking Requests
# RESEND_API_KEY: Your Resend API credential (e.g., re_1234567890...)
RESEND_API_KEY=""

# SENDER_EMAIL: The sender address. Prior to custom domain setup, Resend forces this to "Villa Leopardi <onboarding@resend.dev>".
# Once a domain is verified on Resend, you can change this to e.g., "Villa Leopardi Concierge <booking@yourdomain.com>".
SENDER_EMAIL="Villa Leopardi <onboarding@resend.dev>"

# ADMIN_EMAIL: The destination email that receives all reservation details (e.g., zorziriccardo20@gmail.com)
ADMIN_EMAIL=""

# STRIPE_SECRET_KEY: Required for generating Stripe Checkout sessions.
STRIPE_SECRET_KEY=""
